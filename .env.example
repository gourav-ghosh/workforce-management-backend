# =============================================================================
# Workforce Management Backend — environment configuration example
# Copy this file to `.env` and adjust values per environment.
# NEVER commit a real `.env`.
# =============================================================================

# --- Core Django -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------------
# Two supported ways to configure the database. DATABASE_URL wins when set;
# otherwise the discrete POSTGRES_*/DB_* values below are assembled into a URL.
# If neither is present, local development falls back to SQLite (db.sqlite3).
#
# 1) Single URL (preferred; what Docker/Railway/Heroku inject automatically):
#    DATABASE_URL=postgresql://user:password@host:5432/dbname
# 2) Discrete parts (used by docker-compose.prod.yml, which builds the URL
#    from these three values and the `db` service hostname):
#    POSTGRES_DB=workforce_management
#    POSTGRES_USER=workforce
#    POSTGRES_PASSWORD=change-me-to-a-strong-database-password
#
# For a non-Docker PostgreSQL server, also set DB_HOST/DB_PORT, e.g.
# DB_HOST=db.example.com
# DB_PORT=5432
DATABASE_URL=
POSTGRES_DB=workforce_management
POSTGRES_USER=workforce
POSTGRES_PASSWORD=change-me-to-a-strong-database-password
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=60
# Production only: require TLS to the database (e.g. require)
DATABASE_SSLMODE=

# --- Public origin used when building absolute media URLs in API responses ---
# Leave empty in local DEBUG to use the request host, or set to the
# externally reachable origin (e.g. https://api.example.com) in staging /
# production so the mobile app can fetch uploaded images.
PUBLIC_BASE_URL=

# --- CORS ----------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Static & media -------------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# --- Uploads ----------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- JWT ----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Worker passwords are set by the admin at creation time (POST /api/v1/workers/).
# --- Pagination ------------------------------------------------------------------------
PAGE_SIZE=20

# --- Attendance -----------------------------------------------------------------------
# Shift start used to flag a late punch-in, and the timezone that time is
# interpreted in. Date-times are stored in UTC; the late comparison is done in
# ATTENDANCE_TIMEZONE, so 08:30 IST is correctly late against an 08:00 IST shift.
ATTENDANCE_START_TIME=08:00
ATTENDANCE_TIMEZONE=Asia/Kolkata
# Attendance is a daily log: today or up to this many days back. Future dates
# are always rejected.
ATTENDANCE_MAX_BACKDATE_DAYS=2
# Daily lunch break subtracted from the punch-in-to-punch-out span so the
# billable worked hours are one hour shorter (e.g. 08:00-17:00 = 8h, not 9h).
ATTENDANCE_LUNCH_BREAK_MINUTES=60

# --- TBM & Work Permit -------------------------------------------------------------
# Permit records are a daily log like attendance: today or up to this many
# days back; future dates are always rejected.
PERMIT_MAX_BACKDATE_DAYS=2

# --- Logging -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Email (password reset) ---------------------------------------------------------------
# Development uses console backend by default; production uses SMTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Production security toggles ------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
