# =============================================================================
# Workforce Management Backend — environment configuration example
# Copy this file to `.env` and adjust values per environment.
# NEVER commit a real `.env`.
# =============================================================================

# --- Core Django -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------------
# PostgreSQL connection URL (used in Docker/local Postgres setups).
DATABASE_URL=postgres://workforce:workforce@localhost:5432/workforce_management
DB_CONN_MAX_AGE=60
# Production only: require TLS to the database (e.g. require)
DATABASE_SSLMODE=

# --- CORS ----------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Static & media -------------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# --- Uploads ----------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- JWT ----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Pagination ------------------------------------------------------------------------
PAGE_SIZE=20

# --- Logging -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Email (password reset) ---------------------------------------------------------------
# Development uses console backend by default; production uses SMTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Production security toggles ------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
